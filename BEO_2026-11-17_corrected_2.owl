  <rdf:Description rdf:about="https://w3id.org/bharatanatyam-evaluation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <owl:versionIRI rdf:resource="https://w3id.org/bharatanatyam-evaluation/1.0.0"/>
    <dcterms:creator>Dr. R. Kesavamoorthy</dcterms:creator>
    <dcterms:creator>Anjana K J</dcterms:creator>
    <dcterms:creator>Kruthika N</dcterms:creator>
    <dcterms:creator>Youkthi K B</dcterms:creator>
    <dcterms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
    <rdfs:comment xml:lang="en">The Bharatanatyam taxonomy extended with an evaluation layer: criteria linked to dimension, concept, how they are observed from video, whether software can measure them, the learner level and the method that measures them. The only sensor input is video (stored or live); what software cannot measure from video is assigned to expert gurus.</rdfs:comment>
    <rdfs:label xml:lang="en">Bharatanatyam Evaluation Ontology (BEO)</rdfs:label>
    <owl:versionInfo>1.0.0</owl:versionInfo>
  </rdf:Description>
