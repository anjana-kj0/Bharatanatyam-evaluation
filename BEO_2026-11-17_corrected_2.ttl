@prefix : <https://w3id.org/bharatanatyam-evaluation#> .
@prefix beo: <https://w3id.org/bharatanatyam-evaluation#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@base <https://w3id.org/bharatanatyam-evaluation> .

<https://w3id.org/bharatanatyam-evaluation> rdf:type owl:Ontology ;
                                             owl:versionIRI <https://w3id.org/bharatanatyam-evaluation/1.0.0> ;
                                             dcterms:creator "Anjana K J" ,
                                                             "Dr. R. Kesavamoorthy" ,
                                                             "Kruthika N" ,
                                                             "Youkthi K B" ;
                                             dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
                                             rdfs:comment "The Bharatanatyam taxonomy extended with an evaluation layer: criteria linked to dimension, concept, how they are observed from video, whether software can measure them, the learner level and the method that measures them. The only sensor input is video (stored or live); what software cannot measure from video is assigned to expert gurus."@en ;
                                             rdfs:label "Bharatanatyam Evaluation Ontology (BEO)"@en ;
                                             owl:versionInfo "1.0.0" .

#################################################################
#    Annotation properties
#################################################################

###  http://purl.org/dc/terms/creator
dcterms:creator rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/license
dcterms:license rdf:type owl:AnnotationProperty .


###  https://w3id.org/bharatanatyam-evaluation#alignsWith
beo:alignsWith rdf:type owl:AnnotationProperty ;
               rdfs:comment "The abhinaya concept a dimension corresponds to" ;
               rdfs:label "alignsWith" .


###  https://w3id.org/bharatanatyam-evaluation#altLabel
beo:altLabel rdf:type owl:AnnotationProperty ;
             rdfs:comment "Alternative spelling or synonym" ;
             rdfs:label "altLabel" .


###  https://w3id.org/bharatanatyam-evaluation#cvr
beo:cvr rdf:type owl:AnnotationProperty ;
        rdfs:comment "Content-validity ratio from the gurus survey" ;
        rdfs:label "cvr" .


###  https://w3id.org/bharatanatyam-evaluation#evidenceSource
beo:evidenceSource rdf:type owl:AnnotationProperty ;
                   rdfs:comment "Paper A reference numbers [n] (as in Paper A's reference list) that support a Yes or Partial measurability label, or a technology. 'indirect' marks a proxy study; 'No Paper A study' marks a gap." ;
                   rdfs:label "evidenceSource" .


###  https://w3id.org/bharatanatyam-evaluation#expertCount
beo:expertCount rdf:type owl:AnnotationProperty ;
                rdfs:comment "Number of gurus who rated the criterion" ;
                rdfs:label "expertCount" .


###  https://w3id.org/bharatanatyam-evaluation#reviewStatus
beo:reviewStatus rdf:type owl:AnnotationProperty ;
                 rdfs:comment "draft, expert-checked or revised" ;
                 rdfs:label "reviewStatus" .


#################################################################
#    Object Properties
#################################################################

###  https://w3id.org/bharatanatyam-evaluation#belongsToDimension
beo:belongsToDimension rdf:type owl:ObjectProperty ;
                       rdfs:domain beo:EvaluationCriterion ;
                       rdfs:range beo:EvaluationDimension ;
                       rdfs:comment "The heading that groups the criterion." ;
                       rdfs:label "belongsToDimension" .


###  https://w3id.org/bharatanatyam-evaluation#evaluatesAspectOf
beo:evaluatesAspectOf rdf:type owl:ObjectProperty ;
                      owl:inverseOf beo:isEvaluatedBy ;
                      rdfs:domain beo:EvaluationCriterion ;
                      rdfs:range beo:BharatanatyamConcept ;
                      rdfs:comment "What the criterion assesses." ;
                      rdfs:label "evaluatesAspectOf" .


###  https://w3id.org/bharatanatyam-evaluation#hasAIMeasurability
beo:hasAIMeasurability rdf:type owl:ObjectProperty ,
                                owl:FunctionalProperty ;
                       rdfs:domain beo:EvaluationCriterion ;
                       rdfs:range beo:AIMeasurability ;
                       rdfs:comment "Whether software can measure the criterion from video." ;
                       rdfs:label "hasAIMeasurability" .


###  https://w3id.org/bharatanatyam-evaluation#isEvaluatedBy
beo:isEvaluatedBy rdf:type owl:ObjectProperty ;
                  rdfs:domain beo:BharatanatyamConcept ;
                  rdfs:range beo:EvaluationCriterion ;
                  rdfs:comment "Inverse of evaluatesAspectOf." ;
                  rdfs:label "isEvaluatedBy" .


###  https://w3id.org/bharatanatyam-evaluation#isMeasuredBy
beo:isMeasuredBy rdf:type owl:ObjectProperty ;
                 rdfs:domain beo:EvaluationCriterion ;
                 rdfs:range beo:MeasurementIndicator ;
                 rdfs:comment "The quantity that measures the criterion." ;
                 rdfs:label "isMeasuredBy" .


###  https://w3id.org/bharatanatyam-evaluation#isMeasuredUsing
beo:isMeasuredUsing rdf:type owl:ObjectProperty ;
                    rdfs:domain beo:EvaluationCriterion ;
                    rdfs:range beo:MeasurementTechnology ;
                    rdfs:comment "The video or audio method used to compute the indicators." ;
                    rdfs:label "isMeasuredUsing" .


###  https://w3id.org/bharatanatyam-evaluation#isObservableVia
beo:isObservableVia rdf:type owl:ObjectProperty ;
                    rdfs:domain beo:EvaluationCriterion ;
                    rdfs:range beo:ObservationModality ;
                    rdfs:comment "How the criterion can be observed; one value per usable modality." ;
                    rdfs:label "isObservableVia" .


###  https://w3id.org/bharatanatyam-evaluation#requiredFromLevel
beo:requiredFromLevel rdf:type owl:ObjectProperty ,
                               owl:FunctionalProperty ;
                      rdfs:domain beo:EvaluationCriterion ;
                      rdfs:range beo:ProficiencyLevel ;
                      rdfs:comment "The lowest level from which the criterion is expected." ;
                      rdfs:label "requiredFromLevel" .


#################################################################
#    Data properties
#################################################################

###  https://w3id.org/bharatanatyam-evaluation#levelOrder
beo:levelOrder rdf:type owl:DatatypeProperty ;
               rdfs:domain beo:ProficiencyLevel ;
               rdfs:range xsd:integer ;
               rdfs:comment "Orders the levels 1 to 4." ;
               rdfs:label "levelOrder" .


#################################################################
#    Classes
#################################################################

###  https://w3id.org/bharatanatyam-evaluation#AIMeasurability
beo:AIMeasurability rdf:type owl:Class ;
                    rdfs:comment "Whether software can measure the criterion."@en ;
                    rdfs:label "AI measurability"@en ;
                    beo:reviewStatus "draft" .


###  https://w3id.org/bharatanatyam-evaluation#Aakasha
beo:Aakasha rdf:type owl:Class ;
            rdfs:subClassOf beo:Spins ;
            rdfs:comment "A spin (bhramari): aakasha."@en ;
            rdfs:label "Aakasha"@en ;
            beo:altLabel "aakasha" ;
            beo:reviewStatus "draft" .


###  https://w3id.org/bharatanatyam-evaluation#Abhinaya
beo:Abhinaya rdf:type owl:Class ;
             rdfs:subClassOf beo:BharatanatyamConcept ;
             rdfs:comment "The art of expression in dance, through the body, voice, costume and inner feeling."@en ;
             rdfs:label "Abhinaya"@en ;
             beo:reviewStatus "draft" .


###  https://w3id.org/bharatanatyam-evaluation#Adavu
beo:Adavu rdf:type owl:Class ;
          rdfs:subClassOf beo:Nritta ;
          rdfs:comment "A basic unit of Bharatanatyam footwork and body movement, used to build pure dance (nritta)."@en ;
          rdfs:label "Adavu"@en ;
          beo:reviewStatus "draft" .


###  https://w3id.org/bharatanatyam-evaluation#AdavuAccuracyCriterion
beo:AdavuAccuracyCriterion rdf:type owl:Class ;
                           rdfs:subClassOf beo:EvaluationCriterion ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty beo:evaluatesAspectOf ;
                                             owl:someValuesFrom beo:Adavu
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty beo:belongsToDimension ;
                                             owl:hasValue beo:TechniqueDimension
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty beo:hasAIMeasurability ;
                                             owl:hasValue beo:MeasurablePartial
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty beo:isMeasuredBy ;
                                             owl:hasValue beo:FootStrikeTimingIndicator
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty beo:isMeasuredBy ;
                                             owl:hasValue beo:KneeAngleIndicator
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty beo:isMeasuredBy ;
                                             owl:hasValue beo:SequenceMatchScoreIndicator
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty beo:isMeasuredUsing ;
                                             owl:hasValue beo:ActionRecognitionTechnology
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty beo:isMeasuredUsing ;
                                             owl:hasValue beo:DynamicTimeWarpingTechnology
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty beo:isMeasuredUsing ;
                                             owl:hasValue beo:PoseEstimationTechnology
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty beo:isObservableVia ;
                                             owl:hasValue beo:AudioObservation
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty beo:isObservableVia ;
                                             owl:hasValue beo:LiveHumanObservation
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty beo:isObservableVia ;
                                             owl:hasValue beo:RGBVideoObservation
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty beo:requiredFromLevel ;
                                             owl:hasValue beo:Beginner
                                           ] ;
                           rdfs:comment "Correct form, footwork and arm position of an adavu."@en ;
                           rdfs:label "Adavu accuracy criterion"@en ;
                           beo:altLabel "adavu_accuracy" ;
                           beo:evidenceSource "Paper A [15], [10], [12], [13]" ;
                           beo:reviewStatus "draft" .


###  https://w3id.org/bharatanatyam-evaluation#AdavuFamilies
beo:AdavuFamilies rdf:type owl:Class ;
                  rdfs:subClassOf beo:AdavuSystem ;
                  rdfs:comment "The named groups of adavus."@en ;
                  rdfs:label "Adavu families"@en ;
                  beo:altLabel "adavu_families" ;
                  beo:reviewStatus "draft" .


###  https://w3id.org/bharatanatyam-evaluation#AdavuSystem
beo:AdavuSystem rdf:type owl:Class ;
                rdfs:subClassOf beo:BharatanatyamConcept ;
                rdfs:comment "The system of adavus, the basic footwork units of Bharatanatyam, with their families and the parameters checked in each."@en ;
                rdfs:label "Adavu system"@en ;
                beo:altLabel "Adavu_system" ;
                beo:reviewStatus "draft" .


###  https://w3id.org/bharatanatyam-evaluation#Adbutha
beo:Adbutha rdf:type owl:Class ;
            rdfs:subClassOf beo:Rasa ;
            rdfs:comment "The rasa of wonder."@en ;
            rdfs:label "Adbutha"@en ;
            beo:altLabel "adbutha" ;
            beo:reviewStatus "draft" .


###  https://w3id.org/bharatanatyam-evaluation#Adhomukha
beo:Adhomukha rdf:type owl:Class ;
              rdfs:subClassOf beo:ShiroBheda ;
              rdfs:comment "A head movement (shiro bheda): adhomukha."@en ;
              rdfs:label "Adhomukha"@en ;
              beo:altLabel "adhomukha" ;
              beo:reviewStatus "draft" .


###  https://w3id.org/bharatanatyam-evaluation#Agartala
beo:Agartala rdf:type owl:Class ;
             rdfs:subClassOf beo:PadaBheda ;
             rdfs:comment "A foot position or movement (pada bheda): agartala."@en ;
             rdfs:label "Agartala"@en ;
             beo:altLabel "agartala" ;
             beo:reviewStatus "draft" .


###  https://w3id.org/bharatanatyam-evaluation#AharyaAbhinaya
beo:AharyaAbhinaya rdf:type owl:Class ;
                   rdfs:subClassOf beo:Abhinaya ;
                   rdfs:comment "Expression through external appearance: costume, jewellery, make-up and stage decor."@en ;
                   rdfs:label "Aharya abhinaya"@en ;
                   beo:altLabel "Aharya_Abhinaya" ;
                   beo:reviewStatus "draft" .


###  https://w3id.org/bharatanatyam-evaluation#Aindra
beo:Aindra rdf:type owl:Class ;
           rdfs:subClassOf beo:Sthanaka ;
           rdfs:comment "A sthanaka standing posture: aindra."@en ;
           rdfs:label "Aindra"@en ;
           beo:altLabel "aindra" ;
           beo:reviewStatus "draft" .


###  https://w3id.org/bharatanatyam-evaluation#Alaga
beo:Alaga rdf:type owl:Class ;
          rdfs:subClassOf beo:Leaps ;
          rdfs:comment "A leap (utplavana): alaga."@en ;
          rdfs:label "Alaga"@en ;
          beo:altLabel "alaga" ;
          beo:reviewStatus "draft" .


###  https://w3id.org/bharatanatyam-evaluation#Alapadma
beo:Alapadma rdf:type owl:Class ;
             rdfs:subClassOf beo:AsamyukthaHasta ;
             rdfs:comment "A single-hand gesture (asamyukta hasta): alapadma."@en ;
             rdfs:label "Alapadma"@en ;
             beo:altLabel "alapadma" ;
             beo:reviewStatus "draft" .


###  https://w3id.org/bharatanatyam-evaluation#Alidha
beo:Alidha rdf:type owl:Class ;
           rdfs:subClassOf beo:Mandala ;
           rdfs:comment "A mandala posture: alidha."@en ;
           rdfs:label "Alidha"@en ;
           beo:altLabel "alidha" ;
           beo:reviewStatus "draft" .


###  https://w3id.org/bharatanatyam-evaluation#Alokita
beo:Alokita rdf:type owl:Class ;
            rdfs:subClassOf beo:Drishti ;
            rdfs:comment "An eye movement (drishti bheda): alokita."@en ;
            rdfs:label "Alokita"@en ;
            beo:altLabel "alokita" ;
            beo:reviewStatus "draft" .


###  https://w3id.org/bharatanatyam-evaluation#Alolita
beo:Alolita rdf:type owl:Class ;
            rdfs:subClassOf beo:ShiroBheda ;
            rdfs:comment "A head movement (shiro bheda): alolita."@en ;
            rdfs:label "Alolita"@en ;
            beo:altLabel "alolita" ;
            beo:reviewStatus "draft" .


###  https://w3id.org/bharatanatyam-evaluation#Anchita
beo:Anchita rdf:type owl:Class ;
            rdfs:subClassOf beo:PadaBheda ;
            rdfs:comment "A foot position or movement (pada bheda): anchita."@en ;
            rdfs:label "Anchita"@en ;
            beo:altLabel "anchita" ;
            beo:reviewStatus "draft" .


###  https://w3id.org/bharatanatyam-evaluation#Anga
beo:Anga rdf:type owl:Class ;
         rdfs:subClassOf beo:AngikaAbhinaya ;
         rdfs:comment "The major limbs used in angika abhinaya: head, hands, chest, waist and feet."@en ;
         rdfs:label "Anga"@en ;
         beo:reviewStatus "draft" .


###  https://w3id.org/bharatanatyam-evaluation#AngaSpin
beo:AngaSpin rdf:type owl:Class ;
             rdfs:subClassOf beo:Spins ;
             rdfs:comment "A spin (bhramari): anga spin."@en ;
             rdfs:label "Anga spin"@en ;
             beo:altLabel "anga" ;
             beo:reviewStatus "draft" .


###  https://w3id.org/bharatanatyam-evaluation#AngikaAbhinaya
beo:AngikaAbhinaya rdf:type owl:Class ;
                   rdfs:subClassOf beo:Abhinaya ;
                   rdfs:comment "Expression through the body and its parts."@en ;
                   rdfs:label "Angika abhinaya"@en ;
                   beo:altLabel "Angika_Abhinaya" ;
                   beo:reviewStatus "draft" .


###  https://w3id.org/bharatanatyam-evaluation#Anjali
beo:Anjali rdf:type owl:Class ;
           rdfs:subClassOf beo:SamyuktaHasta ;
           rdfs:comment "A double-hand gesture (samyukta hasta): anjali."@en ;
           rdfs:label "Anjali"@en ;
           beo:altLabel "anjali" ;
           beo:reviewStatus "draft" .


###  https://w3id.org/bharatanatyam-evaluation#Anuvritta
beo:Anuvritta rdf:type owl:Class ;
              rdfs:subClassOf beo:Drishti ;
              rdfs:comment "An eye movement (drishti bheda): anuvritta."@en ;
              rdfs:label "Anuvritta"@en ;
              beo:altLabel "anuvritta" ;
              beo:reviewStatus "draft" .


###  https://w3id.org/bharatanatyam-evaluation#Arala
beo:Arala rdf:type owl:Class ;
          rdfs:subClassOf beo:AsamyukthaHasta ;
          rdfs:comment "A single-hand gesture (asamyukta hasta): arala."@en ;
          rdfs:label "Arala"@en ;
          beo:altLabel "arala" ;
          beo:reviewStatus "draft" .


###  https://w3id.org/bharatanatyam-evaluation#AramandiCriterion
beo:AramandiCriterion rdf:type owl:Class ;
                      rdfs:subClassOf beo:EvaluationCriterion ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty beo:evaluatesAspectOf ;
                                        owl:someValuesFrom beo:Mandala
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty beo:belongsToDimension ;
                                        owl:hasValue beo:TechniqueDimension
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty beo:hasAIMeasurability ;
                                        owl:hasValue beo:MeasurableYes
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty beo:isMeasuredBy ;
                                        owl:hasValue beo:HipHeightConsistencyIndicator
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty beo:isMeasuredBy ;
                                        owl:hasValue beo:KneeAngleIndicator
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty beo:isMeasuredBy ;
                                        owl:hasValue beo:KneeOutwardTurnIndicator
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty beo:isMeasuredBy ;
                                        owl:hasValue beo:TorsoUprightnessIndicator
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty beo:isMeasuredUsing ;
                                        owl:hasValue beo:PoseEstimationTechnology
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty beo:isObservableVia ;
                                        owl:hasValue beo:RGBVideoObservation
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty beo:requiredFromLevel ;
                                        owl:hasValue beo:Beginner
                                      ] ;
                      rdfs:comment "Holding the half-seated posture with knees turned out and the torso upright."@en ;
                      rdfs:label "Aramandi criterion"@en ;
                      beo:altLabel "aramandi" ;
                      beo:evidenceSource "Paper A [19]" ;
                      beo:reviewStatus "draft" .


###  https://w3id.org/bharatanatyam-evaluation#Ardhachandra
beo:Ardhachandra rdf:type owl:Class ;
                 rdfs:subClassOf beo:AsamyukthaHasta ;
                 rdfs:comment "A single-hand gesture (asamyukta hasta): ardhachandra."@en ;
                 rdfs:label "Ardhachandra"@en ;
                 beo:altLabel "ardhachandra" ;
                 beo:reviewStatus "draft" .


###  https://w3id.org/bharatanatyam-evaluation#Ardhapataka
beo:Ardhapataka rdf:type owl:Class ;
                rdfs:subClassOf beo:AsamyukthaHasta ;
                rdfs:comment "A single-hand gesture (asamyukta hasta): ardhapataka."@en ;
                rdfs:label "Ardhapataka"@en ;
                beo:altLabel "ardhapataka" ;
                beo:reviewStatus "draft" .


###  https://w3id.org/bharatanatyam-evaluation#ArmMovement
beo:ArmMovement rdf:type owl:Class ;
                rdfs:subClassOf beo:ParametersCheckedInEveryAdavu ;
                rdfs:comment "An aspect checked in every adavu: arm movement."@en ;
                rdfs:label "Arm movement"@en ;
                beo:altLabel "arm_movement" ;
                beo:reviewStatus "draft" .


###  https://w3id.org/bharatanatyam-evaluation#Arms
beo:Arms rdf:type owl:Class ;
         rdfs:subClassOf beo:Pratyanga ;
         rdfs:comment "A secondary limb used in angika abhinaya: arms."@en ;
         rdfs:label "Arms"@en ;
         beo:reviewStatus "draft" .


###  https://w3id.org/bharatanatyam-evaluation#AsamyukthaHasta
beo:AsamyukthaHasta rdf:type owl:Class ;
                    rdfs:subClassOf beo:HastaBheda ;
                    rdfs:comment "Hand gestures made with a single hand."@en ;
                    rdfs:label "Asamyuktha hasta"@en ;
                    beo:altLabel "Asamyuktha_hasta" ;
                    beo:reviewStatus "draft" .


###  https://w3id.org/bharatanatyam-evaluation#Asva
beo:Asva rdf:type owl:Class ;
         rdfs:subClassOf beo:Leaps ;
         rdfs:comment "A leap (utplavana): asva."@en ;
         rdfs:label "Asva"@en ;
         beo:altLabel "asva" ;
         beo:reviewStatus "draft" .


###  https://w3id.org/bharatanatyam-evaluation#Avahitta
beo:Avahitta rdf:type owl:Class ;
             rdfs:subClassOf beo:SamyuktaHasta ;
             rdfs:comment "A double-hand gesture (samyukta hasta): avahitta."@en ;
             rdfs:label "Avahitta"@en ;
             beo:altLabel "avahitta" ;
             beo:reviewStatus "draft" .


###  https://w3id.org/bharatanatyam-evaluation#Avalokita
beo:Avalokita rdf:type owl:Class ;
              rdfs:subClassOf beo:Drishti ;
              rdfs:comment "An eye movement (drishti bheda): avalokita."@en ;
              rdfs:label "Avalokita"@en ;
              beo:altLabel "avalokita" ;
              beo:reviewStatus "draft" .


###  https://w3id.org/bharatanatyam-evaluation#Ayata
beo:Ayata rdf:type owl:Class ;
          rdfs:subClassOf beo:Mandala ;
          rdfs:comment "A mandala posture: ayata."@en ;
          rdfs:label "Ayata"@en ;
          beo:altLabel "ayata" ;
          beo:reviewStatus "draft" .


###  https://w3id.org/bharatanatyam-evaluation#BalanceCriterion
beo:BalanceCriterion rdf:type owl:Class ;
                     rdfs:subClassOf beo:EvaluationCriterion ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty beo:evaluatesAspectOf ;
                                       owl:someValuesFrom beo:Adavu
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty beo:belongsToDimension ;
                                       owl:hasValue beo:TechniqueDimension
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty beo:hasAIMeasurability ;
                                       owl:hasValue beo:MeasurablePartial
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty beo:isMeasuredBy ;
                                       owl:hasValue beo:CenterOfMassSwayIndicator
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty beo:isMeasuredBy ;
                                       owl:hasValue beo:PostureStabilityIndicator
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty beo:isMeasuredUsing ;
                                       owl:hasValue beo:PoseEstimationTechnology
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty beo:isObservableVia ;
                                       owl:hasValue beo:LiveHumanObservation
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty beo:isObservableVia ;
                                       owl:hasValue beo:RGBVideoObservation
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty beo:requiredFromLevel ;
                                       owl:hasValue beo:Beginner
                                     ] ;
                     rdfs:comment "Staying balanced while performing an adavu."@en ;
                     rdfs:label "Balance criterion"@en ;
                     beo:evidenceSource "Paper A [22] (indirect: force plate, not vision)" ;
                     beo:reviewStatus "draft" .


