#################################################################
#    Individuals
#################################################################

###  https://w3id.org/bharatanatyam-evaluation#AbhinayaDimension
beo:AbhinayaDimension rdf:type owl:NamedIndividual ,
                               beo:EvaluationDimension ;
                      rdfs:comment "Expression: face, eyes, emotion and upper-body expression."@en ;
                      rdfs:label "Abhinaya"@en ;
                      beo:alignsWith beo:SattvikaAbhinaya .


###  https://w3id.org/bharatanatyam-evaluation#ActionRecognitionTechnology
beo:ActionRecognitionTechnology rdf:type owl:NamedIndividual ,
                                         beo:MeasurementTechnology ;
                                rdfs:comment "A model over skeleton or video sequences (e.g. ST-GCN, video transformers) that labels movements such as adavus or karanas. Needs labelled training clips."@en ;
                                rdfs:label "Movement sequence recognition"@en ;
                                beo:evidenceSource "Paper A [10], [11], [13], [37]" .


###  https://w3id.org/bharatanatyam-evaluation#Advanced
beo:Advanced rdf:type owl:NamedIndividual ,
                      beo:ProficiencyLevel ;
             beo:levelOrder 3 ;
             rdfs:comment "Sustained items such as a varnam with developed abhinaya; pre-arangetram stage."@en ;
             rdfs:label "Advanced"@en .


###  https://w3id.org/bharatanatyam-evaluation#AudioObservation
beo:AudioObservation rdf:type owl:NamedIndividual ,
                              beo:ObservationModality ;
                     rdfs:comment "The audio track of the same video: footwork, music and rhythm syllables."@en ;
                     rdfs:label "Audio from video"@en .


###  https://w3id.org/bharatanatyam-evaluation#AudioOnsetDetectionTechnology
beo:AudioOnsetDetectionTechnology rdf:type owl:NamedIndividual ,
                                           beo:MeasurementTechnology ;
                                  rdfs:comment "Detects the time of each foot strike or rhythm syllable in the audio track of the video (e.g. librosa onset detection)."@en ;
                                  rdfs:label "Audio onset detection"@en ;
                                  beo:evidenceSource "Paper A [10], [36] (indirect: audio beat, not foot-strike onset)" .


###  https://w3id.org/bharatanatyam-evaluation#BeatAlignmentErrorIndicator
beo:BeatAlignmentErrorIndicator rdf:type owl:NamedIndividual ,
                                         beo:MeasurementIndicator ;
                                rdfs:comment "Time difference between detected foot strikes or syllables and the beat grid."@en ;
                                rdfs:label "Beat alignment error"@en .


###  https://w3id.org/bharatanatyam-evaluation#Beginner
beo:Beginner rdf:type owl:NamedIndividual ,
                      beo:ProficiencyLevel ;
             beo:levelOrder 1 ;
             rdfs:comment "Foundation: basic stance, simple adavus, basic hand gestures."@en ;
             rdfs:label "Beginner"@en .


###  https://w3id.org/bharatanatyam-evaluation#BodyOrientationIndicator
beo:BodyOrientationIndicator rdf:type owl:NamedIndividual ,
                                      beo:MeasurementIndicator ;
                             rdfs:comment "Body facing direction over time relative to the audience."@en ;
                             rdfs:label "Body orientation"@en .


###  https://w3id.org/bharatanatyam-evaluation#CenterOfMassSwayIndicator
beo:CenterOfMassSwayIndicator rdf:type owl:NamedIndividual ,
                                       beo:MeasurementIndicator ;
                              rdfs:comment "Sideways and forward sway of the body centre estimated from hip and shoulder keypoints."@en ;
                              rdfs:label "Centre-of-mass sway"@en .


###  https://w3id.org/bharatanatyam-evaluation#DepthSkeletonObservation
beo:DepthSkeletonObservation rdf:type owl:NamedIndividual ,
                                      beo:ObservationModality ;
                             rdfs:comment "Depth camera or motion capture giving joint positions. Not used in this project (video-only input); kept for completeness."@en ;
                             rdfs:label "Depth or skeleton capture"@en .


###  https://w3id.org/bharatanatyam-evaluation#DynamicTimeWarpingTechnology
beo:DynamicTimeWarpingTechnology rdf:type owl:NamedIndividual ,
                                          beo:MeasurementTechnology ;
                                 rdfs:comment "Aligns the learner's keypoint sequence with a guru's reference sequence despite speed differences and yields a similarity score."@en ;
                                 rdfs:label "Dynamic time warping against a reference"@en ;
                                 beo:evidenceSource "Paper A [15], [38], [39]" .


###  https://w3id.org/bharatanatyam-evaluation#EyeGazeDirectionIndicator
beo:EyeGazeDirectionIndicator rdf:type owl:NamedIndividual ,
                                       beo:MeasurementIndicator ;
                              rdfs:comment "Gaze direction and its change over time."@en ;
                              rdfs:label "Eye gaze direction"@en .


###  https://w3id.org/bharatanatyam-evaluation#FaceLandmarkDetectionTechnology
beo:FaceLandmarkDetectionTechnology rdf:type owl:NamedIndividual ,
                                             beo:MeasurementTechnology ;
                                    rdfs:comment "Detects facial landmarks from RGB video (e.g. MediaPipe Face Mesh). Needs the face to be large and frontal enough."@en ;
                                    rdfs:label "Face landmark detection"@en ;
                                    beo:evidenceSource "No Paper A study" .


###  https://w3id.org/bharatanatyam-evaluation#FacialExpressionRecognitionTechnology
beo:FacialExpressionRecognitionTechnology rdf:type owl:NamedIndividual ,
                                                   beo:MeasurementTechnology ;
                                          rdfs:comment "A trained classifier that labels facial-expression categories. Trained on everyday emotions, so it covers only part of classical abhinaya."@en ;
                                          rdfs:label "Facial expression recognition"@en ;
                                          beo:evidenceSource "Paper A [33], [34], [31], [35]" .


###  https://w3id.org/bharatanatyam-evaluation#FacialLandmarkDisplacementIndicator
